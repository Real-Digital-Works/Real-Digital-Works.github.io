rules_version = '2';

// Deploy: Firebase Console → Build → Storage → Rules, paste this file, Publish.
// Or: firebase deploy --only storage
// Do not use allow read, write: if true — that opens the whole bucket.

service firebase.storage {
  match /b/{bucket}/o {
    match /work/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
