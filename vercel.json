{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.realdigitalworks.com" }],
      "destination": "https://realdigitalworks.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.realdigitalworks.com" }],
      "destination": "https://realdigitalworks.com/:path*",
      "statusCode": 301
    }
  ]
}
